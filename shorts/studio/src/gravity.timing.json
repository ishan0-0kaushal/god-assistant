  "lines": [
    {"start": 0, "end": 2.4, "text": "In thirty seconds, Earth becomes a *black hole.*", "accent": "red", "hold": true},
    {"start": 2.4, "end": 4.0, "text": "Gravity *doubles* every second.", "accent": "orange"},
    {"start": 4.0, "end": 6.6, "text": "Two G: every step, you *carry a second you.*", "accent": "orange"},
