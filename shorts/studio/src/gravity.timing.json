    {"start": 8.4, "end": 10.6, "text": "Thirty-two: heavier than standing on *the Sun.*", "accent": "orange"},
    {"start": 10.6, "end": 12.8, "text": "Your body now outweighs *an elephant.*", "accent": "orange"},
    {"start": 12.8, "end": 16.0, "text": "A thousand G: the air presses like *ten kilometers under the sea.*", "accent": "blue"},
